{
    "rules": {
        "trips": {
            "$tripId": {
                ".read": "auth != null && (data.child('ownerId').val() === auth.uid || data.child('participants').child(auth.uid).exists())",
                ".write": "auth != null && (data.child('ownerId').val() === auth.uid || !data.exists())",
                "ownerId": {
                    ".validate": "newData.val() === auth.uid"
                },
                "participants": {
                    "$userId": {
                        ".validate": "true"
                    }
                }
            }
        }
    }
}